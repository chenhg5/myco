<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.myco.ios.refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>myco</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.myco.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>myco</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>拍照片发给你的 agent。 Take photos to send to your agents.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>连接局域网里的 myco 工作区，或你在设置里填的局域网代理。 myco connects to workspaces on your local network, and to a proxy there that you set in Settings.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>只在你点了麦克风或在语音聊天时听：把你说的话变成消息，或者和 agent 通话。 myco listens only after you tap the microphone or during a voice chat you started: to turn what you say into a message, or to talk with an agent.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>把对话里的图片存到相册。 Save pictures from conversations to your library.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>把你说的话转成文字（语音输入和语音聊天），用你在 App 里选的语言。 myco turns what you say into text, for dictation and voice chats, in the language you chose for the app.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
