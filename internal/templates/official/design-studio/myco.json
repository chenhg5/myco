{
  "id": "myco/design-studio",
  "name": "设计工作台",
  "version": "1.1.1",
  "kind": "custom",
  "category": "creative",
  "icon": "icon.svg",
  "description": "和 agent 一起设计网页、界面、海报和数据看板。可编辑画布与图层，预览 HTML，收集反馈并保存版本；agent 可通过新版 App 导出共享作品的 SVG、PNG、HTML 或 JSON。",
  "data": {
    "workspace": {
      "single": true,
      "fields": {
        "title": "text",
        "design_notes": "text"
      }
    },
    "artifacts": {
      "fields": {
        "title": "text",
        "kind": "text",
        "description": "text",
        "brief": "text",
        "status": "text",
        "frames": "json",
        "html": "text",
        "order": "number",
        "updated": "text"
      }
    },
    "comments": {
      "fields": {
        "artifact": "text",
        "text": "text",
        "author": "text",
        "resolved": "bool",
        "at": "text",
        "order": "number"
      }
    },
    "versions": {
      "fields": {
        "artifact": "text",
        "label": "text",
        "snapshot": "json",
        "at": "text",
        "order": "number"
      }
    }
  },
  "permissions": [
    "download",
    "send"
  ],
  "export": [
    "svg",
    "png",
    "html",
    "json"
  ],
  "requires": {
    "hub": "0.20.7"
  }
}
