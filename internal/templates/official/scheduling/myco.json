{
  "id": "myco/scheduling",
  "name": "日历",
  "version": "1.1.1",
  "kind": "custom",
  "category": "office",
  "icon": "icon.svg",
  "description": "管理自己的工作与生活日程：月、周、日视图，点击日期新建，拖动改期，全天与重复日程，搜索和日历导出。与 agent 一起安排；预约管理放在次级入口。",
  "data": {
    "profile": {
      "single": true,
      "fields": {
        "title": "text",
        "host": "text",
        "bio": "text",
        "zone": "text"
      }
    },
    "types": {
      "fields": {
        "title": "text",
        "description": "text",
        "duration": "number",
        "location": "text",
        "notice": "number",
        "horizon": "number",
        "before": "number",
        "after": "number",
        "enabled": "bool",
        "order": "number"
      }
    },
    "availability": {
      "single": true,
      "fields": {
        "week": "json",
        "overrides": "json"
      }
    },
    "days": {
      "fields": {
        "entries": "json"
      }
    },
    "events": {
      "fields": {
        "title": "text",
        "start": "text",
        "end": "text",
        "all_day": "bool",
        "zone": "text",
        "calendar": "text",
        "location": "text",
        "notes": "text",
        "busy": "bool",
        "repeat": "text",
        "until": "text",
        "owner": "person"
      }
    }
  },
  "permissions": [
    "download"
  ],
  "requires": {
    "hub": "0.20.7"
  }
}
