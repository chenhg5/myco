        "w": "number",
        "h": "number",
        "text": "text",
        "color": "text",
        "from": "text",
        "to": "text",
        "z": "number",
        "from_side": "text",
        "to_side": "text",
        "route": "text",
        "dash": "text",
        "align": "text",
        "width": "number",
        "font_size": "number",
        "locked": "bool"
      }
    },
    "exports": {
      "single": true,
      "fields": {
