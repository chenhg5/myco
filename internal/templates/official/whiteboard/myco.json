{
  "id": "myco/whiteboard",
  "name": "白板",
  "version": "1.5.0",
  "kind": "board",
  "category": "creative",
  "icon": "icon.svg",
  "description": "一块无限大的画布：便签、文字、形状和连线。和 agent 共同编辑，导出 SVG/PNG；兼容新版 App 时，agent 可在后台导出共享白板。",
  "data": {
    "board": {
      "single": true,
      "fields": {
        "title": "text"
      }
    },
    "items": {
      "fields": {
        "type": "text",
        "x": "number",
        "y": "number",
        "w": "number",
        "h": "number",
        "text": "text",
        "color": "text",
        "from": "text",
        "to": "text",
        "z": "number",
        "from_side": "text",
        "to_side": "text",
        "route": "text",
        "dash": "text",
        "align": "text",
        "width": "number",
        "font_size": "number",
        "locked": "bool"
      }
    },
    "exports": {
      "single": true,
      "fields": {
        "schema": "number",
        "source_fingerprint": "text",
        "source_records": "number",
        "generated_at": "text",
        "status": "text",
        "media_type": "text",
        "svg": "text",
        "width": "number",
        "height": "number"
      }
    }
  },
  "permissions": [
    "download"
  ],
  "export": [
    "svg",
    "png"
  ],
  "requires": {
    "hub": "0.20.7"
  }
}
