  "version": "1.0.1",
  "kind": "custom",
  "category": "creative",
  "icon": "icon.svg",
  "description": "录下屏幕，直接裁剪、分割、加文字和重点放大，在本机导出 MP4。视频留在本机，剪辑方案可以交给 agent 协作。",
  "data": {
    "project": {
      "single": true,
      "fields": {
        "title": "text",
        "ratio": "text",
        "background": "text",
        "fps": "number"
      }
    },
    "media": {
      "fields": {
        "name": "text",
        "size": "number",
        "duration": "number",
        "width": "number",
        "height": "number",
        "audio": "bool",
        "key": "text",
        "poster": "text"
      }
    },
    "clips": {
      "fields": {
        "media": "text",
        "in": "number",
        "out": "number",
        "speed": "number",
        "volume": "number",
        "muted": "bool",
        "order": "number"
      }
    },
    "overlays": {
      "fields": {
        "type": "text",
        "start": "number",
        "end": "number",
        "x": "number",
        "y": "number",
        "w": "number",
        "h": "number",
        "strength": "number",
        "text": "text",
        "color": "text",
        "size": "number",
        "style": "text",
        "lane": "number"
      }
    },
    "notes": {
      "fields": {
        "time": "number",
        "text": "text",
        "done": "bool",
        "by": "person"
      }
    }
  },
  "permissions": [
    "download"
  ],
  "export": [
    "mp4"
  ],
  "requires": {
    "hub": "0.20.7"
  }
}
