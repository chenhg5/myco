{
  "id": "myco/base",
  "name": "多维表格",
  "version": "2.1.0",
  "kind": "records",
  "category": "office",
  "icon": "icon.svg",
  "description": "像飞书多维表格：同一份记录，表格、看板、日历、画廊、表单几种视图，点一条在右侧展开；字段有类型，筛选、排序，导出 Excel。",
  "data": {
    "base": {
      "single": true,
      "fields": {
        "title": "text",
        "fields": "json"
      }
    },
    "records": {
      "fields": {
        "values": "json",
        "order": "number"
      }
    }
  },
  "permissions": [
    "download"
  ],
  "export": [
    "csv",
    "xlsx"
  ],
  "requires": {
    "hub": "0.20.7"
  }
}
