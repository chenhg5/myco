        "poster": "text",
        "order": "number",
        "by": "person",
        "rotate": "number",
        "flip_h": "bool",
        "flip_v": "bool",
        "straighten": "number",
        "crop": "json",
        "ratio": "text",
        "adjust": "json",
        "filter": "text",
        "filter_strength": "number",
        "beauty": "json",
        "layers": "json",
        "frame": "text",
        "frame_color": "text"
      }
    }
  },
  "permissions": [
    "download"
  ],
  "export": [
    "jpg",
    "png"
  ],
  "requires": {
    "hub": "0.20.7"
  }
}
