{
  "id": "myco/scheduling",
  "name": "日程预约",
  "version": "1.0.1",
  "kind": "custom",
  "category": "office",
  "icon": "icon.svg",
  "description": "安排交流、评审和咨询：设置预约类型、每周可用时间与例外日期，按时区选择时段、填写信息，管理或取消预约，导出日历；和 agent 共用一份日程。",
  "data": {
    "profile": {
      "single": true,
      "fields": {
        "title": "text",
        "host": "text",
        "bio": "text",
        "zone": "text"
      }
    },
    "types": {
      "fields": {
        "title": "text",
        "description": "text",
        "duration": "number",
        "location": "text",
        "notice": "number",
        "horizon": "number",
        "before": "number",
        "after": "number",
        "enabled": "bool",
        "order": "number"
      }
    },
    "availability": {
      "single": true,
      "fields": {
        "week": "json",
        "overrides": "json"
      }
    },
    "days": {
      "fields": {
        "entries": "json"
      }
    }
  },
  "permissions": [
    "download"
  ],
  "requires": {
    "hub": "0.20.7"
  }
}
