{
  "id": "myco/mindmap",
  "name": "思维导图",
  "version": "1.2.1",
  "kind": "custom",
  "category": "creative",
  "icon": "icon.svg",
  "description": "agent 写一份大纲，网页画成思维导图；Tab 加子主题、Enter 加同级、拖动换位置、折叠分支，导出 Markdown 大纲。",
  "data": {
    "map": {
      "single": true,
      "fields": {
        "title": "text"
      }
    },
    "nodes": {
      "fields": {
        "text": "text",
        "parent": "text",
        "order": "number",
        "collapsed": "bool"
      }
    }
  },
  "permissions": [
    "download"
  ],
  "export": [
    "md"
  ],
  "requires": {
    "hub": "0.20.7"
  }
}
