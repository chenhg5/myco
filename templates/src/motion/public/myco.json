{
  "id": "myco/motion",
  "name": "动效视频",
  "version": "1.0.0",
  "kind": "custom",
  "category": "creative",
  "icon": "icon.svg",
  "description": "做产品宣传、数据快报、竖版短视频这类动效视频：从模板开始改文字、图片和配色，或者说一句话让 agent 写好每个场景（HTML 加动画）；时间轴上调时长和转场，在本机导出 mp4。",
  "data": {
    "project": {
      "single": true,
      "fields": {
        "title": "text",
        "ratio": "text",
        "fps": "number",
        "bg": "text",
        "fg": "text",
        "accent": "text",
        "accent2": "text",
        "font": "text",
        "motion": "markdown"
      }
    },
    "scenes": {
      "fields": {
        "name": "text",
        "order": "number",
        "duration": "number",
        "transition": "text",
        "transition_time": "number",
        "template": "text",
        "html": "text",
        "css": "text",
        "script": "text",
        "fields": "json"
      }
    },
    "assets": {
      "fields": {
        "name": "text",
        "data": "text",
        "width": "number",
        "height": "number"
      }
    },
    "notes": {
      "fields": {
        "time": "number",
        "text": "text",
        "done": "bool",
        "by": "person"
      }
    }
  },
  "permissions": [
    "send",
    "download"
  ],
  "export": [
    "mp4"
  ],
  "requires": {
    "hub": "0.20.7"
  }
}
