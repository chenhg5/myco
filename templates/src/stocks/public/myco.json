{
  "id": "myco/stocks",
  "name": "行情工作台",
  "version": "1.0.2",
  "kind": "custom",
  "category": "tools",
  "icon": "icon.svg",
  "description": "在同一个工作台关注 A 股、港股、美股：共享自选与观察笔记，查看日周月 K 线、成交量和均线，导出行情。数据源可切换，支持接入自己的行情网关；行情由打开应用的电脑获取。",
  "data": {
    "watchlist": {
      "fields": {
        "market": "text",
        "symbol": "text",
        "name": "text",
        "order": "number",
        "note": "text"
      }
    }
  },
  "permissions": [
    "download"
  ],
  "export": [
    "csv",
    "json",
    "png"
  ],
  "requires": {
    "hub": "0.20.7"
  }
}
