{
  "id": "myco/issues",
  "name": "任务追踪",
  "version": "1.4.1",
  "kind": "custom",
  "category": "dev",
  "icon": "icon.svg",
  "description": "像 Linear 那样管问题和项目：编号、状态、优先级、负责人、标签，列表和看板，键盘就能操作；问题可以指给 agent，它改状态、写评论，你这边马上看到。",
  "data": {
    "team": {
      "single": true,
      "fields": {
        "title": "text",
        "key": "text"
      }
    },
    "issues": {
      "fields": {
        "n": "number",
        "title": "text",
        "desc": "markdown",
        "status": "text",
        "priority": "number",
        "assignee": "person",
        "labels": "multi",
        "project": "text",
        "due": "date",
        "estimate": "number",
        "order": "number",
        "by": "person",
        "created": "datetime",
        "done_at": "datetime"
      }
    },
    "projects": {
      "fields": {
        "name": "text",
        "desc": "markdown",
        "status": "text",
        "lead": "person",
        "target": "date",
        "order": "number"
      }
    },
    "comments": {
      "fields": {
        "issue": "text",
        "body": "markdown",
        "by": "person",
        "at": "datetime"
      }
    }
  },
  "requires": {
    "hub": "0.20.7"
  }
}
