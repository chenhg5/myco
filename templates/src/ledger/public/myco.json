{
  "id": "myco/ledger",
  "name": "记账本",
  "version": "1.0.0",
  "kind": "custom",
  "category": "life",
  "icon": "icon.svg",
  "description": "记收入和支出：每月支出、收入、结余和预算剩余，按分类看钱花在哪，按天列出每一笔；家里或小团队一起记，agent 能把账单整理进来。",
  "data": {
    "book": {
      "single": true,
      "fields": {
        "title": "text",
        "currency": "text",
        "budget": "number"
      }
    },
    "entries": {
      "fields": {
        "kind": "text",
        "amount": "number",
        "category": "text",
        "note": "text",
        "date": "date"
      }
    }
  },
  "permissions": [
    "download"
  ],
  "export": [
    "csv"
  ],
  "requires": {
    "hub": "0.20.7"
  }
}
